# =========================================================
# Cellchat
# =========================================================
rule cellchat:
    input:
        seurat_annoted="output/annotation/marker_annotation_v2/data/seurat_filtered_annoted.rds",
    output:
        bundled_ccc="output/ccc/ccc_bundle_HT_vs_CNT.rds",
    params:
        script_cc1="src/cellchat/cellchat.R",
    conda:
        PIPELINE_DIR / "envs/cellchat.yaml"
    shell:
        """
        echo 'Installing NMF 0.28'
        Rscript -e 'install.packages("NMF", version = "0.28", repos = "https://cloud.r-project.org")'

        echo 'Installing CellChat'
        Rscript -e 'devtools::install_github("jinworks/CellChat@623f48f")'

        echo 'Running cell to cell communication comparing conditions'
        Rscript {params.script_cc1}
        """


rule cellchat_grouped:
